{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // packages/agent is a pure library with no Workers-specific globals.
    // WebWorker lib provides AbortSignal, ReadableStream and other Web APIs used
    // by the agent loop. Workers packages get these via wrangler types instead.
    "lib": ["ES2022", "WebWorker"],
    // Override the types array to avoid Workers types colliding with Node test env.
    "types": []
  },
  "include": ["src/**/*", "test/**/*"]
}
