{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    // verbatimModuleSyntax must be off for test files: the `cloudflare:test` ambient
    // module declaration (.d.ts) is not itself an ES module, which violates
    // verbatimModuleSyntax. Tests import from "cloudflare:test" which is a virtual
    // module only available inside Miniflare at runtime.
    "verbatimModuleSyntax": false,
    "types": ["@cloudflare/vitest-pool-workers/types"],
    // skipLibCheck: true already set in base, but also needed here because the
    // cloudflare-test.d.ts ambient declaration file is not itself an ES module.
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/worker-configuration.d.ts"]
}
