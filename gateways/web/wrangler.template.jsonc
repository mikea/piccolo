{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piccolo-web-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",

  // ── Service bindings ───────────────────────────────────────────────────
  "services": [
    {
      "binding": "CORE",
      "service": "piccolo-core"
    }
  ],

  // ── Static assets (SPA) ───────────────────────────────────────────────
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  "vars": {
    // The user ID stamped on all sessions for this deployment.
    "USER_ID": "default-user"
  }
}
