{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piccolo-web-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",

  // ── Service bindings ───────────────────────────────────────────────────
  "services": [
    {
      "binding": "CORE",
      "service": "piccolo-core"
    }
  ],

  // ── Static assets (SPA) ───────────────────────────────────────────────
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }

  // Auth: Cloudflare Access (Zero Trust) enforces login.
  // The Cf-Access-Jwt-Assertion header is injected by CF on every request.
  // The Worker decodes the JWT payload to extract the user's email as userId.
  // No secret or additional config needed here — configure the Access
  // application in the Cloudflare Zero Trust dashboard.
}
