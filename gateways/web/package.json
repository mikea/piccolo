{
  "name": "@piccolo/web-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "piccolo-web-gateway: Web UI gateway Worker",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build:app": "pnpm --dir app build",
    "build": "pnpm build:app && wrangler deploy --dry-run --config wrangler.template.jsonc",
    "deploy": "pnpm build:app && wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts --config wrangler.template.jsonc"
  },
  "dependencies": {
    "@piccolo/api": "workspace:*",
    "capnweb": "^0.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.13.4",
    "vitest": "*",
    "wrangler": "*"
  }
}
