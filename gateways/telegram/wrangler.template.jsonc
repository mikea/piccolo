{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "piccolo-telegram-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",

  // ── Service bindings ───────────────────────────────────────────────────
  "services": [
    {
      // JSRPC connection to piccolo-core (IPiccoloCore WorkerEntrypoint).
      "binding": "CORE",
      "service": "piccolo-core"
    }
  ],

  // ── Durable Objects ────────────────────────────────────────────────────
  "durable_objects": {
    "bindings": [
      {
        "name": "TELEGRAM_SESSION",
        "class_name": "TelegramSessionDO"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TelegramSessionDO"]
    }
  ],

  // ── Vars ───────────────────────────────────────────────────────────────
  "vars": {
    // JSON array of allowed Telegram user IDs.
    // Example: [123456789, 987654321]
    "ALLOWED_TELEGRAM_USER_IDS": "[]"
  }

  // ── Secrets (set via wrangler secret put, never committed) ─────────────
  // TELEGRAM_BOT_TOKEN  — Telegram Bot API token
}
