{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ext-skills",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-24",

  "d1_databases": [
    {
      "binding": "SKILLS_DB",
      "database_name": "piccolo-skills",
      "database_id": "<SKILLS_DB_ID>"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "piccolo-assets"
    }
  ]
}
